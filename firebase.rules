rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Helper function to check if user is the owner
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Users collection - users can read/write their own data
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
    }

    // CVs collection - users can read/write their own CVs
    match /cvs/{cvId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
    }

    // Cover letters collection - users can read/write their own
    match /coverLetters/{letterId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
    }

    // Job emails collection - users can read/write their own
    match /jobEmails/{emailId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
    }

    // Portfolios collection - users can read/write their own
    match /portfolios/{portfolioId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
    }

    // Websites collection - users can read/write their own
    match /websites/{websiteId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
    }

    // Company profiles collection - users can read/write their own
    match /companyProfiles/{profileId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
    }

    // Business proposals collection - users can read/write their own
    match /businessProposals/{proposalId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
    }

    // Orders collection - users can read/write their own orders
    match /orders/{orderId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
    }

    // Payments collection - users can read their own payment data
    match /payments/{paymentId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false; // Payments should be created through server-side functions
    }

    // Transactions collection - users can read their own transactions
    match /transactions/{transactionId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false; // Transactions should be created through server-side functions
    }

    // Blog posts - public read, authenticated write
    match /blogPosts/{postId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Chat messages - users can read/write messages they're part of
    match /chatMessages/{messageId} {
      allow read: if isSignedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow write: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
      allow create: if isSignedIn();
    }

    // Notifications - users can read/write their own notifications
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if false; // Notifications should be created through server-side functions
    }

    // Design projects - users can read/write their own projects
    match /designProjects/{projectId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
    }

    // 3D projects - users can read/write their own projects
    match /threeDProjects/{projectId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
    }

    // Services collection - public read, authenticated write (for admin panel)
    match /services/{serviceId} {
      allow read: if true;
      allow write: if true;
    }

    // Quotations collection - public read, authenticated write (for admin panel)
    match /quotations/{quotationId} {
      allow read: if true;
      allow write: if true;
    }

    // Invoices collection - public read, authenticated write (for admin panel)
    match /invoices/{invoiceId} {
      allow read: if true;
      allow write: if true;
    }

    // Customers collection - public read, authenticated write (for admin panel)
    match /customers/{customerId} {
      allow read: if true;
      allow write: if true;
    }

    // Terms collection - public read, authenticated write (for admin panel)
    match /terms/{termId} {
      allow read: if true;
      allow write: if true;
    }

    // Directors collection - public read, authenticated write (for admin panel)
    match /directors/{directorId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
